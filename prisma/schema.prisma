generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator prismabox { 
  provider = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName = "t"
  inputModel = true
  output   = "../generated/prismabox"
}

enum ResourceRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model ResourceRequest {
  id           String   @id @default(uuid())
  incidentId   String
  priority     String
  requestFor   String
  status       ResourceRequestStatus   @default(NEW)

  requestedAt  DateTime @default(now())

  requesterName String
  phone         String

  address       String
  description   String?
  latitude      Float
  longitude     Float

  items        RequestedItem[]
  extraItems   RequestedExtraItem[]
}

model RequestedItem {
  id        String @id @default(uuid())
  requestId String
  itemId    String
  amount    Int

  request   ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RequestedExtraItem {
  id        String @id @default(uuid())
  requestId String
  name      String
  amount    Int

  request   ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}
